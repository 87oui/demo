---
import Layout from '@/layouts/MusicLibrary.astro'
import { getAlbums } from '@/libs/itunes'

const data = await getAlbums({ term: 'J-Pop', limit: 200 })
---

<Layout title="Music library">
  <div class="grid gap-y-5 p-5">
    <h1 class="text-2xl font-bold">Music Library</h1>
    <div class="grid grid-cols-[repeat(auto-fill,100px)] justify-center gap-10">
      {
        data.map(({ collectionId, collectionName, artworkUrl100 }) => (
          <a
            href={`/music-library/${collectionId}`}
            class="transition-transform duration-400 hover:scale-120"
            aria-label={`${collectionName}の詳細ページへ移動`}>
            <img
              src={artworkUrl100}
              alt=""
              width="100"
              height="100"
              class=""
              transition:name={`artwork-${collectionId}`}
            />
          </a>
        ))
      }
    </div>
    <p class="text-right text-xs">
      アートワークは
      <a
        href="https://developer.apple.com/library/archive/documentation/AudioVideo/Conceptual/iTuneSearchAPI/index.html"
        class="underline">
        iTunes Search API
      </a>
      から取得しています。これは技術デモです。
    </p>
  </div>
</Layout>
